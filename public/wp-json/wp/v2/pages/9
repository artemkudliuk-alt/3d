{"id":9,"date":"2025-03-24T12:11:11","date_gmt":"2025-03-24T12:11:11","guid":{"rendered":"https:\/\/lagom-development.com\/?page_id=9"},"modified":"2026-01-08T13:11:43","modified_gmt":"2026-01-08T13:11:43","slug":"privacy-policy","status":"publish","type":"page","link":"https:\/\/lagom-development.com\/privacy-policy\/","title":{"rendered":"\u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">\u0426\u044f \u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0442\u0430 \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u0441\u0430\u0439\u0442\u0443 (\u0434\u0430\u043b\u0456 \u2014 <strong>\u0421\u0430\u0439\u0442<\/strong>), \u044f\u043a\u0456 \u043d\u0430\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0421\u0430\u0439\u0442\u043e\u043c, \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0444\u043e\u0440\u043c \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u043e\u0433\u043e \u0437\u0432\u2019\u044f\u0437\u043a\u0443 \u0430\u0431\u043e \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u0457 \u0437 \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0454\u044e.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0412\u043b\u0430\u0441\u043d\u0438\u043a\u043e\u043c \u0442\u0430 \u0430\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c \u0421\u0430\u0439\u0442\u0443 \u0454 <strong>\u0422\u041e\u0412 \u041b\u0410\u0413\u041e\u041c \u0414\u0415\u0412\u0415\u041b\u041e\u041f\u041c\u0415\u041d\u0422<\/strong> (\u0434\u0430\u043b\u0456 \u2014 <strong>\u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f<\/strong>).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u044e\u0447\u0438\u0441\u044c \u0421\u0430\u0439\u0442\u043e\u043c, \u0432\u0438 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454\u0442\u0435 \u0441\u0432\u043e\u044e \u0437\u0433\u043e\u0434\u0443 \u0437 \u0443\u043c\u043e\u0432\u0430\u043c\u0438 \u0446\u0456\u0454\u0457 \u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0438 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>1. \u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0456 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044f<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">1.1. \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u043f\u043e\u0432\u0430\u0436\u0430\u0454 \u043f\u0440\u0430\u0432\u043e \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043d\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0437\u0430\u0445\u0438\u0441\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0432\u0438\u043c\u043e\u0433 \u0447\u0438\u043d\u043d\u043e\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0417\u0430\u043a\u043e\u043d\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u00ab\u041f\u0440\u043e \u0437\u0430\u0445\u0438\u0441\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445\u00bb.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">1.2. \u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0456 \u0434\u0430\u043d\u0456 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0432\u0438\u043a\u043b\u044e\u0447\u043d\u043e \u0437 \u043c\u0435\u0442\u043e\u044e \u043d\u0430\u0434\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0456\u0439, \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u0457 \u0437 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430\u043c\u0438, \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0437\u0430\u044f\u0432\u043e\u043a, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0434\u043b\u044f \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f \u0441\u0435\u0440\u0432\u0456\u0441\u0456\u0432 \u0456 \u0440\u043e\u0431\u043e\u0442\u0438 \u0421\u0430\u0439\u0442\u0443.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>2. \u042f\u043a\u0456 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0456 \u0434\u0430\u043d\u0456 \u043c\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u043c\u043e<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u043c\u043e\u0436\u0435 \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u0442\u0430 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u0442\u0438 \u0442\u0430\u043a\u0456 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0456 \u0434\u0430\u043d\u0456:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0456\u043c\u2019\u044f \u0442\u0430 \u043f\u0440\u0456\u0437\u0432\u0438\u0449\u0435;<\/li>\n\n\n\n<li>\u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443;<\/li>\n\n\n\n<li>\u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e, \u044f\u043a\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u0434\u043e\u0431\u0440\u043e\u0432\u0456\u043b\u044c\u043d\u043e \u043d\u0430\u0434\u0430\u0454 \u0447\u0435\u0440\u0435\u0437 \u0444\u043e\u0440\u043c\u0438 \u043d\u0430 \u0421\u0430\u0439\u0442\u0456;<\/li>\n\n\n\n<li>\u0434\u0430\u043d\u0456, \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u0456 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0438\u0445 \u0434\u0437\u0432\u0456\u043d\u043a\u0456\u0432, \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0432 \u043c\u0435\u0441\u0435\u043d\u0434\u0436\u0435\u0440\u0430\u0445 \u0430\u0431\u043e \u0456\u043d\u0448\u0438\u0445 \u043a\u0430\u043d\u0430\u043b\u0456\u0432 \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u0457;<\/li>\n\n\n\n<li>\u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e: IP-\u0430\u0434\u0440\u0435\u0441\u0443, \u0442\u0438\u043f \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430, \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439, \u0444\u0430\u0439\u043b\u0438 cookie, \u0434\u0430\u043d\u0456 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0421\u0430\u0439\u0442\u0443.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>3. \u041c\u0435\u0442\u0430 \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0456 \u0434\u0430\u043d\u0456 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0437 \u043c\u0435\u0442\u043e\u044e:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0437\u0432\u2019\u044f\u0437\u043a\u0443 \u0437 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0435\u043c \u0442\u0430 \u043d\u0430\u0434\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0456\u0439 \u0449\u043e\u0434\u043e \u043f\u0440\u043e\u0454\u043a\u0442\u0456\u0432 \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u0457;<\/li>\n\n\n\n<li>\u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0437\u0432\u0435\u0440\u043d\u0435\u043d\u044c, \u0437\u0430\u044f\u0432\u043e\u043a \u0442\u0430 \u0437\u0430\u043f\u0438\u0442\u0456\u0432;<\/li>\n\n\n\n<li>\u0456\u043d\u0444\u043e\u0440\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u043e \u043e\u0431\u2019\u0454\u043a\u0442\u0438 \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u043e\u0441\u0442\u0456, \u0443\u043c\u043e\u0432\u0438 \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f, \u0430\u043a\u0446\u0456\u0457 \u0442\u0430 \u043d\u043e\u0432\u0438\u043d\u0438 (\u0437\u0430 \u0437\u0433\u043e\u0434\u043e\u044e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430);<\/li>\n\n\n\n<li>\u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u0443 \u0437\u0432\u0435\u0440\u043d\u0435\u043d\u044c \u0443 CRM-\u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445;<\/li>\n\n\n\n<li>\u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438 \u0442\u0430 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f \u044f\u043a\u043e\u0441\u0442\u0456 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433\u043e\u0432\u0438\u0445 \u0456 \u0441\u0435\u0440\u0432\u0456\u0441\u043d\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0456\u0432.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>4. \u041a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u044f \u0447\u0435\u0440\u0435\u0437 Viber, Telegram, \u0434\u0437\u0432\u0456\u043d\u043a\u0438 \u0442\u0430 CRM<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">4.1. \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u043c\u043e\u0436\u0435 \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0432\u0430\u0442\u0438 \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u044e \u0437 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430\u043c\u0438 \u0447\u0435\u0440\u0435\u0437 \u0442\u0430\u043a\u0456 \u043a\u0430\u043d\u0430\u043b\u0438:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0456 \u0434\u0437\u0432\u0456\u043d\u043a\u0438;<\/li>\n\n\n\n<li>\u043c\u0435\u0441\u0435\u043d\u0434\u0436\u0435\u0440\u0438 <strong>Viber<\/strong> \u0442\u0430 <strong>Telegram<\/strong>;<\/li>\n\n\n\n<li>CRM-\u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0434\u043b\u044f \u0444\u0456\u043a\u0441\u0430\u0446\u0456\u0457 \u0442\u0430 \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0437\u0432\u0435\u0440\u043d\u0435\u043d\u044c.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">4.2. \u0417\u0432\u0435\u0440\u0442\u0430\u044e\u0447\u0438\u0441\u044c \u0434\u043e \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u0457 \u0430\u0431\u043e \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0447\u0438 \u0441\u0432\u043e\u0457 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0456 \u0434\u0430\u043d\u0456, \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u043d\u0430\u0434\u0430\u0454 \u0437\u0433\u043e\u0434\u0443 \u043d\u0430 \u043e\u0431\u0440\u043e\u0431\u043a\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0442\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u0443 \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u044e \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0456 \u043a\u0430\u043d\u0430\u043b\u0438 \u0437 \u043c\u0435\u0442\u043e\u044e \u043d\u0430\u0434\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0456\u0439 \u0442\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u0449\u043e\u0434\u043e \u043f\u0440\u043e\u0454\u043a\u0442\u0456\u0432 \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u0457.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">4.3. \u0422\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0456 \u0434\u0437\u0432\u0456\u043d\u043a\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u0443\u0432\u0430\u0442\u0438\u0441\u044c \u0437 \u043c\u0435\u0442\u043e\u044e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044e \u044f\u043a\u043e\u0441\u0442\u0456 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0443.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>5. \u0420\u0435\u043a\u043b\u0430\u043c\u0430, \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430 \u0442\u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456 \u0441\u0435\u0440\u0432\u0456\u0441\u0438<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">5.1. \u0421\u0430\u0439\u0442 \u043c\u043e\u0436\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456 \u0441\u0435\u0440\u0432\u0456\u0441\u0438 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438 \u0442\u0430 \u0440\u0435\u043a\u043b\u0430\u043c\u0438, \u0437\u043e\u043a\u0440\u0435\u043c\u0430:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Google Ads<\/strong>;<\/li>\n\n\n\n<li><strong>Meta (Facebook, Instagram)<\/strong>;<\/li>\n\n\n\n<li>\u0441\u0435\u0440\u0432\u0456\u0441\u0438 \u0432\u0435\u0431-\u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438 (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, Google Analytics).<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">5.2. \u0426\u0456 \u0441\u0435\u0440\u0432\u0456\u0441\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0444\u0430\u0439\u043b\u0438 cookie \u0442\u0430 \u0437\u043d\u0435\u043e\u0441\u043e\u0431\u043b\u0435\u043d\u0456 \u0434\u0430\u043d\u0456 \u0434\u043b\u044f:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0430\u043d\u0430\u043b\u0456\u0437\u0443 \u043f\u043e\u0432\u0435\u0434\u0456\u043d\u043a\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u043d\u0430 \u0421\u0430\u0439\u0442\u0456;<\/li>\n\n\n\n<li>\u043f\u043e\u043a\u0430\u0437\u0443 \u0440\u0435\u043b\u0435\u0432\u0430\u043d\u0442\u043d\u043e\u0457 \u0440\u0435\u043a\u043b\u0430\u043c\u0438;<\/li>\n\n\n\n<li>\u043e\u0446\u0456\u043d\u043a\u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456 \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u0438\u0445 \u043a\u0430\u043c\u043f\u0430\u043d\u0456\u0439.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">5.3. \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u043d\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0454 \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u0438\u043c \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0456 \u0434\u0430\u043d\u0456 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432, \u044f\u043a\u0456 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442\u044c \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u043e\u0441\u043e\u0431\u0443.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>6. \u0417\u0430\u0445\u0438\u0441\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">6.1. \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u0432\u0436\u0438\u0432\u0430\u0454 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u0445 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0438\u0445 \u0442\u0430 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0439\u043d\u0438\u0445 \u0437\u0430\u0445\u043e\u0434\u0456\u0432 \u0434\u043b\u044f \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0432\u0456\u0434 \u043d\u0435\u0441\u0430\u043d\u043a\u0446\u0456\u043e\u043d\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0443, \u0432\u0442\u0440\u0430\u0442\u0438, \u0437\u043c\u0456\u043d\u0438 \u0430\u0431\u043e \u0440\u043e\u0437\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043d\u044f.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">6.2. \u0414\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u043c\u0430\u044e\u0442\u044c \u043b\u0438\u0448\u0435 \u0443\u043f\u043e\u0432\u043d\u043e\u0432\u0430\u0436\u0435\u043d\u0456 \u043f\u0440\u0430\u0446\u0456\u0432\u043d\u0438\u043a\u0438 \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u0457 \u0432 \u043c\u0435\u0436\u0430\u0445 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0441\u0432\u043e\u0457\u0445 \u0441\u043b\u0443\u0436\u0431\u043e\u0432\u0438\u0445 \u043e\u0431\u043e\u0432\u2019\u044f\u0437\u043a\u0456\u0432.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>7. \u041f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0442\u0440\u0435\u0442\u0456\u043c \u043e\u0441\u043e\u0431\u0430\u043c<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">7.1. \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u043d\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0454 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0456 \u0434\u0430\u043d\u0456 \u0442\u0440\u0435\u0442\u0456\u043c \u043e\u0441\u043e\u0431\u0430\u043c, \u0437\u0430 \u0432\u0438\u043d\u044f\u0442\u043a\u043e\u043c \u0432\u0438\u043f\u0430\u0434\u043a\u0456\u0432:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0441\u0435\u0440\u0432\u0456\u0441\u0456\u0432 CRM, \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438 \u0442\u0430 \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c;<\/li>\n\n\n\n<li>\u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0432\u0438\u043c\u043e\u0433 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438;<\/li>\n\n\n\n<li>\u043d\u0430\u044f\u0432\u043d\u043e\u0441\u0442\u0456 \u043f\u0440\u044f\u043c\u043e\u0457 \u0437\u0433\u043e\u0434\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">7.2. \u041f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0434\u0430\u043d\u0438\u0445 \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437 \u0434\u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f\u043c \u0432\u0438\u043c\u043e\u0433 \u0449\u043e\u0434\u043e \u0457\u0445 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u0431\u0435\u0437\u043f\u0435\u043a\u0438.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>8. \u041f\u0440\u0430\u0432\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u043c\u0430\u0454 \u043f\u0440\u0430\u0432\u043e:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u043f\u0440\u043e \u043e\u0431\u0440\u043e\u0431\u043a\u0443 \u0441\u0432\u043e\u0457\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445;<\/li>\n\n\n\n<li>\u0432\u0438\u043c\u0430\u0433\u0430\u0442\u0438 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044f, \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445;<\/li>\n\n\n\n<li>\u0432\u0456\u0434\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0437\u0433\u043e\u0434\u0443 \u043d\u0430 \u043e\u0431\u0440\u043e\u0431\u043a\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445;<\/li>\n\n\n\n<li>\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u0434\u043e \u041a\u043e\u043c\u043f\u0430\u043d\u0456\u0457 \u0437 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u043c \u0437\u0430\u043f\u0438\u0442\u043e\u043c.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>9. \u0417\u043c\u0456\u043d\u0438 \u0434\u043e \u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0438 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u041a\u043e\u043c\u043f\u0430\u043d\u0456\u044f \u0437\u0430\u043b\u0438\u0448\u0430\u0454 \u0437\u0430 \u0441\u043e\u0431\u043e\u044e \u043f\u0440\u0430\u0432\u043e \u0432\u043d\u043e\u0441\u0438\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0434\u043e \u0446\u0456\u0454\u0457 \u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0438 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u043e\u0441\u0442\u0456. \u0410\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430 \u0432\u0435\u0440\u0441\u0456\u044f \u0437\u0430\u0432\u0436\u0434\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043d\u0430 \u0421\u0430\u0439\u0442\u0456.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>10. \u041a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u0417 \